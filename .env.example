# Copia este archivo a `.env.local` y rellena los valores.
# Nunca subas secretos al repo.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://andrescoellog.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Acceso a /apply e /interview ---
# Clave que Andres escribe en la UI para desbloquear.
# Generar: openssl rand -base64 32
APPLY_ACCESS_SECRET=

# Firma HMAC de la cookie de sesión (OBLIGATORIA y distinta de la anterior).
# Si falta, /apply falla cerrado (500 en unlock, 401 en el resto).
# Generar: openssl rand -base64 32
APPLY_SESSION_SECRET=

# --- Gmail (contacto público y postulaciones) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=

# --- Gemini ---
GEMINI_API_KEY=
# Opcionales
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
GEMINI_TIMEOUT_MS=
