# Copia este archivo a `.env.local` y rellena los valores.
# Nunca subas secretos al repo.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://andrescoellog.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Acceso a /apply e /interview ---
# Clave que Andres escribe en la UI para desbloquear.
# Generar: openssl rand -base64 32
APPLY_ACCESS_SECRET=

# Firma HMAC de la cookie de sesión (OBLIGATORIA y distinta de la anterior).
# Si falta, /apply falla cerrado (500 en unlock, 401 en el resto).
# Generar: openssl rand -base64 32
APPLY_SESSION_SECRET=

# --- Gmail (contacto público y postulaciones) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=

# --- Redis (Upstash). Preferir las vars manuales; KV es respaldo ---
# Crear a mano en Upstash o con `vercel env pull`.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Respaldo si la integración de Vercel Marketplace las inyecta:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Zona para días del historial y resúmenes (opcional)
RADAR_TIMEZONE=America/Guayaquil

# --- Telegram (Fase 2) ---
# Token de @BotFather. Quien lo tenga controla el bot.
TELEGRAM_BOT_TOKEN=
# chat.id numérico (getUpdates, ANTES de setWebhook)
TELEGRAM_CHAT_ID=
# Obligatorio para el webhook. Sin esto, /api/telegram/webhook responde 503.
# Generar: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Gemini ---
GEMINI_API_KEY=
# Opcionales
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
GEMINI_TIMEOUT_MS=
